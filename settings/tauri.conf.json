{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskPaw Settings",
  "version": "1.4.0",
  "identifier": "app.deskpause.settings",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "settings", "title": "DeskPaw settings", "width": 838, "height": 595, "minWidth": 520, "minHeight": 440, "center": true, "backgroundColor": "#191c20" }
    ],
    "security": {
      "capabilities": [{ "identifier": "settings", "windows": ["settings"], "permissions": [] }],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
